{
  "name": "expence-tracker",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev:backend": "npm run start:dev -w apps/backend",
    "build:frontend": "npm run build -w apps/frontend",
    "build:backend": "npm run build -w apps/backend",
    "prisma:generate": "npm run prisma:generate -w packages/db",
    "prisma:migrate": "npm run prisma:migrate -w packages/db",
    "prisma:studio": "npm run prisma:studio -w packages/db"
  },
  "engines": {
    "node": ">=20"
  }
}
